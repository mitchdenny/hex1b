<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <GenerateDocumentationFile>true</GenerateDocumentationFile>
    <IsAotCompatible>true</IsAotCompatible>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- Preserve the consuming project's RID when selecting native content. -->
    <IsRidAgnostic>false</IsRidAgnostic>

    <!-- Embed source code for debugging -->
    <EmbedAllSources>true</EmbedAllSources>
    <DebugType>embedded</DebugType>
    <DebugSymbols>true</DebugSymbols>

    <!-- Package Metadata -->
    <PackageId>Hex1b</PackageId>
    <Title>Hex1b</Title>
    <Authors>Mitch Denny</Authors>
    <Copyright>Copyright (c) 2024 Mitch Denny</Copyright>
    <Description>Build user interfaces for terminal apps using an approachable code-first API.</Description>
    <PackageTags>tui;terminal;console;ui;widgets;ansi;cli</PackageTags>
    
    <!-- License -->
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    
    <!-- Repository -->
    <RepositoryUrl>https://github.com/mitchdenny/hex1b</RepositoryUrl>
    <RepositoryType>git</RepositoryType>
    <PackageProjectUrl>https://github.com/mitchdenny/hex1b</PackageProjectUrl>
    
    <!-- README -->
    <PackageReadmeFile>README.md</PackageReadmeFile>
    
    <!-- Release Notes -->
    <PackageReleaseNotes>See https://github.com/hex1b/hex1b/releases for release notes.</PackageReleaseNotes>
    
    <!-- Additional Package Settings -->
    <PackageRequireLicenseAcceptance>false</PackageRequireLicenseAcceptance>
    <NoWarn>$(NoWarn);CS1591;HEX1B0100</NoWarn>

    <!--
      Public-surface validation. PackageValidationBaselineVersion lives in the
      bot-managed block below and is rewritten by .github/workflows/baseline-bump.yml
      after every stable release (see that workflow for the full rules). Until
      the first stable release ships the baseline element is absent, so we only
      get intra-package framework-compat checks; once it appears, breaking-API
      changes against the published baseline surface as build errors locally
      and in CI. To deliberately ship a breaking change, comment the element
      out for the spike and let the bot restore it on the next release.
    -->
    <!--
      Deliberately disabled for this change: removes the public
      CellAttributes.Sixel / TerminalCell.TrackedSixel per-cell Sixel
      ownership surface (see issue #451) in favor of independent
      SixelGraphicsState. The bot will restore this on the next release.
    -->
    <!-- <EnablePackageValidation>true</EnablePackageValidation> -->
    <!-- BEGIN: bot-managed baseline -->
    <PackageValidationBaselineVersion>0.173.0</PackageValidationBaselineVersion>
    <!-- END: bot-managed baseline -->
  </PropertyGroup>

  <ItemGroup>
    <InternalsVisibleTo Include="Hex1b.Tests" />
    <InternalsVisibleTo Include="Hex1b.Benchmarks" />
    <InternalsVisibleTo Include="Hex1b.Tool" />
    <InternalsVisibleTo Include="Hex1b.Tool.Tests" />
    <InternalsVisibleTo Include="hex1bpty" />
    <InternalsVisibleTo Include="SixelTerminalDemo" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" Version="10.0.12" />
    <PackageReference Include="QRCoder" Version="1.8.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="README.md" Pack="true" PackagePath="/" />
    <None Include="../../THIRD-PARTY-NOTICES.txt" Pack="true" PackagePath="/" />
  </ItemGroup>

  <ItemGroup>
    <!-- Bundled FIGlet fonts. LogicalName matches FigletFont.OpenBundledResource(...) lookup. -->
    <EmbeddedResource Include="Widgets/FigletFonts/*.flf" LogicalName="Hex1b.Widgets.FigletFonts.%(Filename).flf" />
  </ItemGroup>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <!-- Local Windows builds default to a debuggable helper; pack flips this to AOT automatically. -->
    <Hex1bPtyHostEnabled>true</Hex1bPtyHostEnabled>
    <Hex1bPtyHostPackPublishMode Condition="'$(Hex1bPtyHostPackPublishMode)' == ''">Aot</Hex1bPtyHostPackPublishMode>
    <WindowsPtyShimRid Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">win-arm64</WindowsPtyShimRid>
    <WindowsPtyShimRid Condition="'$(WindowsPtyShimRid)' == ''">win-x64</WindowsPtyShimRid>
    <Hex1bPtyHostPackRids Condition="'$(Hex1bPtyHostPackRids)' == ''">$(WindowsPtyShimRid)</Hex1bPtyHostPackRids>
    <WindowsPtyShimPublishRoot>$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)windows-pty-shim</WindowsPtyShimPublishRoot>
    <WindowsPtyShimPublishDir>$(WindowsPtyShimPublishRoot)\$(WindowsPtyShimRid)\native</WindowsPtyShimPublishDir>
    <WindowsPtyHostProject>$(MSBuildProjectDirectory)\..\Hex1b.PtyHost\Hex1b.PtyHost.csproj</WindowsPtyHostProject>
    <WindowsPtyHostTargetFramework>net8.0</WindowsPtyHostTargetFramework>
    <WindowsPtyHostBuildOutputDir>$(MSBuildProjectDirectory)\..\Hex1b.PtyHost\bin\$(Configuration)\$(WindowsPtyHostTargetFramework)\$(WindowsPtyShimRid)</WindowsPtyHostBuildOutputDir>
  </PropertyGroup>
  <PropertyGroup>
    <Hex1bPtyHostEnabled Condition="'$(Hex1bPtyHostEnabled)' == ''">false</Hex1bPtyHostEnabled>
    <Hex1bPtyHostPublishMode Condition="'$(Hex1bPtyHostPublishMode)' == ''">Debug</Hex1bPtyHostPublishMode>
    <WindowsPtyShimExecutableName Condition="'$(WindowsPtyShimExecutableName)' == ''">hex1bpty.exe</WindowsPtyShimExecutableName>
    <TargetsForTfmSpecificContentInPackage>$(TargetsForTfmSpecificContentInPackage);IncludeWindowsPtyShimInPackage</TargetsForTfmSpecificContentInPackage>
    <BuildDependsOn>$(BuildDependsOn);SyncFreshManagedOutput</BuildDependsOn>
  </PropertyGroup>

  <!-- 
    Native interop library for Unix platforms (hex1binterop)
    
    The runtimes folder structure follows NuGet conventions:
      runtimes/{RID}/native/{library}
    
    When packed, these get placed in the NuGet package under runtimes/
    and .NET's runtime loader automatically finds them based on the current RID.
  -->

  <!-- Select by runtime, never by which native artifacts happen to exist. -->
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Linux'))">
    <NativeHostRid>linux-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</NativeHostRid>
    <NativeHostRid Condition="$([System.Runtime.InteropServices.RuntimeInformation]::RuntimeIdentifier.StartsWith('linux-musl-'))">linux-musl-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</NativeHostRid>
  </PropertyGroup>
  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('OSX'))">
    <NativeHostRid>osx-$([System.Runtime.InteropServices.RuntimeInformation]::ProcessArchitecture.ToString().ToLowerInvariant())</NativeHostRid>
  </PropertyGroup>
  <PropertyGroup>
    <NativeLibraryRid Condition="'$(RuntimeIdentifier)' == ''">$(NativeHostRid)</NativeLibraryRid>
    <NativeLibraryRid Condition="'$(RuntimeIdentifier)' != ''">$(RuntimeIdentifier)</NativeLibraryRid>
    <NativeLibraryName Condition="'$(NativeLibraryRid)' == 'linux-x64' or '$(NativeLibraryRid)' == 'linux-arm64' or '$(NativeLibraryRid)' == 'linux-musl-x64'">libhex1binterop.so</NativeLibraryName>
    <NativeLibraryName Condition="'$(NativeLibraryRid)' == 'osx-x64' or '$(NativeLibraryRid)' == 'osx-arm64'">libhex1binterop.dylib</NativeLibraryName>
  </PropertyGroup>
  <PropertyGroup Condition="'$(NativeLibraryName)' != ''">
    <NativeLibraryPath>$(MSBuildThisFileDirectory)runtimes/$(NativeLibraryRid)/native/$(NativeLibraryName)</NativeLibraryPath>
    <NativeLibraryTargetArch Condition="$(NativeLibraryRid.EndsWith('-x64'))">x86_64</NativeLibraryTargetArch>
    <NativeLibraryTargetArch Condition="'$(NativeLibraryRid)' == 'linux-arm64'">aarch64</NativeLibraryTargetArch>
    <NativeLibraryTargetArch Condition="'$(NativeLibraryRid)' == 'osx-arm64'">arm64</NativeLibraryTargetArch>
    <NativeLibraryTargetLibc Condition="$(NativeLibraryRid.StartsWith('linux-musl-'))">musl</NativeLibraryTargetLibc>
    <NativeLibraryTargetLibc Condition="'$(NativeLibraryTargetLibc)' == ''">gnu</NativeLibraryTargetLibc>
    <NativeLibraryCanBuild Condition="'$(NativeLibraryRid)' == '$(NativeHostRid)' or ($([MSBuild]::IsOSPlatform('OSX')) and $(NativeLibraryRid.StartsWith('osx-')))">true</NativeLibraryCanBuild>
    <NativeLibraryBuildOutputs>$(NativeLibraryPath)</NativeLibraryBuildOutputs>
    <!-- A checked-in or downloaded binary must not hide a missing local native build. -->
    <NativeLibraryBuildOutputs Condition="'$(NativeLibraryCanBuild)' == 'true'">$(NativeLibraryBuildOutputs);$(MSBuildThisFileDirectory)obj/native/$(NativeLibraryRid)/hex1binterop.o</NativeLibraryBuildOutputs>
  </PropertyGroup>

  <!-- Declare generated content before it exists so the SDK handles transitive build/publish copies. -->
  <ItemGroup Condition="'$(NativeLibraryPath)' != ''">
    <Content Include="$(NativeLibraryPath)"
             Link="$(NativeLibraryName)"
             CopyToOutputDirectory="Always"
             CopyToPublishDirectory="Always"
             Pack="true"
             PackagePath="runtimes/$(NativeLibraryRid)/native" />
  </ItemGroup>

  <Target Name="BuildNativeInteropLibrary"
          BeforeTargets="PrepareForBuild;GetCopyToOutputDirectoryItems"
          Condition="'$(NativeLibraryPath)' != ''"
          Inputs="$(MSBuildThisFileDirectory)native/hex1binterop.c;$(MSBuildThisFileDirectory)native/Makefile"
          Outputs="$(NativeLibraryBuildOutputs)">
    <Error Condition="'$(NativeLibraryCanBuild)' != 'true' and !Exists('$(NativeLibraryPath)')"
           Text="Native interop for $(NativeLibraryRid) cannot be built on this host. Build it on a matching host and place it at $(NativeLibraryPath) before cross-publishing." />
    <Message Importance="High" Condition="'$(NativeLibraryCanBuild)' == 'true'"
             Text="Building native interop for $(NativeLibraryRid). Requires make and a C compiler (Ubuntu/Debian: sudo apt install build-essential; Alpine: apk add build-base; macOS: xcode-select --install)." />
    <Exec Condition="'$(NativeLibraryCanBuild)' == 'true'"
          Command="make TARGET_ARCH=$(NativeLibraryTargetArch) TARGET_LIBC=$(NativeLibraryTargetLibc)"
          WorkingDirectory="$(MSBuildThisFileDirectory)native" />
  </Target>

  <Target Name="SyncFreshManagedOutput"
          Condition="'$(DesignTimeBuild)' != 'true' and Exists('$(MSBuildProjectDirectory)\$(IntermediateOutputPath)$(TargetFileName)')">
    <Copy SourceFiles="$(MSBuildProjectDirectory)\$(IntermediateOutputPath)$(TargetFileName)"
          DestinationFiles="$(TargetDir)$(TargetFileName)"
          SkipUnchangedFiles="false"
          OverwriteReadOnlyFiles="true" />
  </Target>

  <Target Name="PublishWindowsPtyShim"
          Condition="'$(Hex1bPtyHostEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(DisableHex1bPtyShimPublish)' != 'true' and Exists('$(WindowsPtyHostProject)')"
          AfterTargets="Build">
    <Message Importance="High" Text="Building Windows PTY host ($(Hex1bPtyHostPublishMode)) for $(WindowsPtyShimRid)..." />
    <RemoveDir Directories="$(WindowsPtyShimPublishDir)" />
    <MakeDir Directories="$(WindowsPtyShimPublishDir)" />

    <MSBuild Projects="$(WindowsPtyHostProject)"
             Targets="Restore;Build"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(WindowsPtyShimRid)"
             BuildInParallel="false"
             Condition="'$(Hex1bPtyHostPublishMode)' != 'Aot'" />

    <ItemGroup Condition="'$(Hex1bPtyHostPublishMode)' != 'Aot'">
      <WindowsPtyShimBuiltFiles Include="$(WindowsPtyHostBuildOutputDir)\**\*.*"
                               Exclude="$(WindowsPtyHostBuildOutputDir)\**\*.pdb;$(WindowsPtyHostBuildOutputDir)\**\*.dbg;$(WindowsPtyHostBuildOutputDir)\**\*.map;$(WindowsPtyHostBuildOutputDir)\**\*.lib;$(WindowsPtyHostBuildOutputDir)\**\*.exp" />
    </ItemGroup>

    <Copy SourceFiles="@(WindowsPtyShimBuiltFiles)"
          DestinationFiles="@(WindowsPtyShimBuiltFiles->'$(WindowsPtyShimPublishDir)\%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true"
          Condition="'$(Hex1bPtyHostPublishMode)' != 'Aot'" />

    <MSBuild Projects="$(WindowsPtyHostProject)"
             Targets="Restore;Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=$(WindowsPtyShimRid);PublishAot=true;SelfContained=true;PublishDir=$(WindowsPtyShimPublishDir)\"
             BuildInParallel="false"
             Condition="'$(Hex1bPtyHostPublishMode)' == 'Aot'" />
  </Target>

  <Target Name="CopyWindowsPtyShimToOutput"
          AfterTargets="PublishWindowsPtyShim"
          Condition="$([MSBuild]::IsOSPlatform('Windows')) and Exists('$(WindowsPtyShimPublishDir)')">
    <ItemGroup>
      <WindowsPtyShimOutputFiles Include="$(WindowsPtyShimPublishDir)\**\*.*"
                                 Exclude="$(WindowsPtyShimPublishDir)\**\*.pdb;$(WindowsPtyShimPublishDir)\**\*.dbg;$(WindowsPtyShimPublishDir)\**\*.map;$(WindowsPtyShimPublishDir)\**\*.lib;$(WindowsPtyShimPublishDir)\**\*.exp" />
      <WindowsPtyShimOutputSymbolFiles Include="$(TargetDir)hex1bpty.pdb;$(TargetDir)hex1bpty.dbg;$(TargetDir)hex1bpty.map;$(TargetDir)hex1bpty.lib;$(TargetDir)hex1bpty.exp" />
    </ItemGroup>
    <Copy SourceFiles="@(WindowsPtyShimOutputFiles)"
          DestinationFiles="@(WindowsPtyShimOutputFiles->'$(TargetDir)%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />
    <Delete Files="@(WindowsPtyShimOutputSymbolFiles)" TreatErrorsAsWarnings="true" />
  </Target>

  <Target Name="PruneWindowsPtyShimSymbols"
          AfterTargets="PublishWindowsPtyShim;PublishWindowsPtyShimForPack"
          Condition="'$(Hex1bPtyHostEnabled)' == 'true' and Exists('$(WindowsPtyShimPublishRoot)')">
    <ItemGroup>
      <WindowsPtyShimSymbolFiles Include="$(WindowsPtyShimPublishRoot)\**\*.pdb;$(WindowsPtyShimPublishRoot)\**\*.dbg;$(WindowsPtyShimPublishRoot)\**\*.map;$(WindowsPtyShimPublishRoot)\**\*.lib;$(WindowsPtyShimPublishRoot)\**\*.exp" />
    </ItemGroup>
    <Delete Files="@(WindowsPtyShimSymbolFiles)" TreatErrorsAsWarnings="true" />
  </Target>

  <Target Name="PublishWindowsPtyShimForPack"
          Condition="'$(Hex1bPtyHostEnabled)' == 'true' and '$(DesignTimeBuild)' != 'true' and '$(DisableHex1bPtyShimPublish)' != 'true' and Exists('$(WindowsPtyHostProject)')">
    <ItemGroup>
      <WindowsPtyShimPackRid Include="$(Hex1bPtyHostPackRids)" />
    </ItemGroup>
    <Message Importance="High" Text="Building Windows PTY host ($(Hex1bPtyHostPackPublishMode)) for packaging: @(WindowsPtyShimPackRid, ', ')." />
    <RemoveDir Directories="@(WindowsPtyShimPackRid -> '$(WindowsPtyShimPublishRoot)\%(Identity)\native')" />
    <MakeDir Directories="@(WindowsPtyShimPackRid -> '$(WindowsPtyShimPublishRoot)\%(Identity)\native')" />
    <MSBuild Projects="$(WindowsPtyHostProject)"
             Targets="Restore;Publish"
             Properties="Configuration=$(Configuration);RuntimeIdentifier=%(WindowsPtyShimPackRid.Identity);PublishAot=true;SelfContained=true;PublishDir=$(WindowsPtyShimPublishRoot)\%(WindowsPtyShimPackRid.Identity)\native\"
             BuildInParallel="false" />
  </Target>
  
  <!-- The selected runtime is packed by its Content item; include other prebuilt runtimes too. -->
  <ItemGroup>
    <None Include="runtimes/linux-x64/native/libhex1binterop.so"
          Condition="'$(NativeLibraryRid)' != 'linux-x64' and Exists('runtimes/linux-x64/native/libhex1binterop.so')"
          Pack="true"
          PackagePath="runtimes/linux-x64/native" />
    <None Include="runtimes/linux-arm64/native/libhex1binterop.so"
          Condition="'$(NativeLibraryRid)' != 'linux-arm64' and Exists('runtimes/linux-arm64/native/libhex1binterop.so')"
          Pack="true"
          PackagePath="runtimes/linux-arm64/native" />
    <None Include="runtimes/linux-musl-x64/native/libhex1binterop.so"
          Condition="'$(NativeLibraryRid)' != 'linux-musl-x64' and Exists('runtimes/linux-musl-x64/native/libhex1binterop.so')"
          Pack="true"
          PackagePath="runtimes/linux-musl-x64/native" />
    <None Include="runtimes/osx-x64/native/libhex1binterop.dylib"
          Condition="'$(NativeLibraryRid)' != 'osx-x64' and Exists('runtimes/osx-x64/native/libhex1binterop.dylib')"
          Pack="true"
          PackagePath="runtimes/osx-x64/native" />
    <None Include="runtimes/osx-arm64/native/libhex1binterop.dylib"
          Condition="'$(NativeLibraryRid)' != 'osx-arm64' and Exists('runtimes/osx-arm64/native/libhex1binterop.dylib')"
          Pack="true"
          PackagePath="runtimes/osx-arm64/native" />
  </ItemGroup>
  
  <Target Name="IncludeWindowsPtyShimInPackage"
          DependsOnTargets="PublishWindowsPtyShimForPack">
    <ItemGroup>
      <WindowsPtyShimPackageFile Include="$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)windows-pty-shim\win-x64\native\**\*.*"
                                 Exclude="$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)windows-pty-shim\win-x64\native\**\*.pdb;$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)windows-pty-shim\win-x64\native\**\*.dbg;$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)windows-pty-shim\win-x64\native\**\*.map;$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)windows-pty-shim\win-x64\native\**\*.lib;$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)windows-pty-shim\win-x64\native\**\*.exp"
                                 Condition="'$(Hex1bPtyHostEnabled)' == 'true' and Exists('$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)windows-pty-shim\win-x64\native\$(WindowsPtyShimExecutableName)')">
        <PtyRid>win-x64</PtyRid>
      </WindowsPtyShimPackageFile>
      <WindowsPtyShimPackageFile Include="$(MSBuildProjectDirectory)\runtimes\win-x64\native\**\*.*"
                                 Exclude="$(MSBuildProjectDirectory)\runtimes\win-x64\native\**\*.pdb;$(MSBuildProjectDirectory)\runtimes\win-x64\native\**\*.dbg;$(MSBuildProjectDirectory)\runtimes\win-x64\native\**\*.map;$(MSBuildProjectDirectory)\runtimes\win-x64\native\**\*.lib;$(MSBuildProjectDirectory)\runtimes\win-x64\native\**\*.exp"
                                 Condition="'$(Hex1bPtyHostEnabled)' != 'true' and Exists('$(MSBuildProjectDirectory)\runtimes\win-x64\native\$(WindowsPtyShimExecutableName)')">
        <PtyRid>win-x64</PtyRid>
      </WindowsPtyShimPackageFile>
      <WindowsPtyShimPackageFile Include="$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)windows-pty-shim\win-arm64\native\**\*.*"
                                 Exclude="$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)windows-pty-shim\win-arm64\native\**\*.pdb;$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)windows-pty-shim\win-arm64\native\**\*.dbg;$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)windows-pty-shim\win-arm64\native\**\*.map;$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)windows-pty-shim\win-arm64\native\**\*.lib;$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)windows-pty-shim\win-arm64\native\**\*.exp"
                                 Condition="'$(Hex1bPtyHostEnabled)' == 'true' and Exists('$(MSBuildProjectDirectory)\$(BaseIntermediateOutputPath)windows-pty-shim\win-arm64\native\$(WindowsPtyShimExecutableName)')">
        <PtyRid>win-arm64</PtyRid>
      </WindowsPtyShimPackageFile>
      <WindowsPtyShimPackageFile Include="$(MSBuildProjectDirectory)\runtimes\win-arm64\native\**\*.*"
                                 Exclude="$(MSBuildProjectDirectory)\runtimes\win-arm64\native\**\*.pdb;$(MSBuildProjectDirectory)\runtimes\win-arm64\native\**\*.dbg;$(MSBuildProjectDirectory)\runtimes\win-arm64\native\**\*.map;$(MSBuildProjectDirectory)\runtimes\win-arm64\native\**\*.lib;$(MSBuildProjectDirectory)\runtimes\win-arm64\native\**\*.exp"
                                 Condition="'$(Hex1bPtyHostEnabled)' != 'true' and Exists('$(MSBuildProjectDirectory)\runtimes\win-arm64\native\$(WindowsPtyShimExecutableName)')">
        <PtyRid>win-arm64</PtyRid>
      </WindowsPtyShimPackageFile>
      <TfmSpecificPackageFile Include="@(WindowsPtyShimPackageFile)">
        <PackagePath>runtimes/%(PtyRid)/native/</PackagePath>
      </TfmSpecificPackageFile>
    </ItemGroup>
  </Target>

</Project>
