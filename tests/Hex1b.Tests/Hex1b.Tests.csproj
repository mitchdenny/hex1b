<Project Sdk="MSTest.Sdk/4.2.3">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <IsPackable>false</IsPackable>
    <OutputType>Exe</OutputType>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.TimeProvider.Testing" Version="9.0.0" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Hex1b\Hex1b.csproj" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="../../samples/CloudDemo.Shared/CloudPalette.cs" Link="Samples/CloudPalette.cs" />
    <Compile Include="../../samples/CloudDemo.Shared/DustCloud.cs" Link="Samples/DustCloud.cs" />
    <Compile Include="../../samples/CloudDemo.Shared/ICloudRenderer.cs" Link="Samples/ICloudRenderer.cs" />
    <Compile Include="../../samples/CloudDemo.Shared/MoteCursorOrder.cs" Link="Samples/MoteCursorOrder.cs" />
    <Compile Include="../../samples/SixelCloudDemo/SixelCloudRenderer.cs" Link="Samples/SixelCloudRenderer.cs" />
    <Compile Include="../../samples/WebTerminalDemo/Hmp1BrowserView.cs" Link="Samples/Hmp1BrowserView.cs" />
    <Compile Include="../../samples/WebTerminalDemo/DuplexPipeStream.cs" Link="Samples/DuplexPipeStream.cs" />
    <Compile Include="../../samples/WebTerminalDemo/BrowserCloseRequest.cs" Link="Samples/BrowserCloseRequest.cs" />
    <Compile Include="../../samples/WebTerminalDemo/BrowserSession.cs" Link="Samples/BrowserSession.cs" />
    <Compile Include="../../samples/WebTerminalDemo/InitialViewFailure.cs" Link="Samples/InitialViewFailure.cs" />
    <Compile Include="../../samples/WebTerminalDemo/TerminalView.cs" Link="Samples/TerminalView.cs" />
    <Compile Include="../../samples/WebTerminalDemo/TerminalInstance.cs" Link="Samples/TerminalInstance.cs" />
    <Compile Include="../../samples/WebTerminalDemo/TerminalRegistry.cs" Link="Samples/TerminalRegistry.cs" />
    <Compile Include="../../samples/WebTerminalDemo/CreateTerminalRequest.cs" Link="Samples/CreateTerminalRequest.cs" />
    <Compile Include="../../samples/WebTerminalDemo/TerminalInstanceInfo.cs" Link="Samples/TerminalInstanceInfo.cs" />
    <Compile Include="../../samples/WebTerminalDemo/TerminalControlsRequest.cs" Link="Samples/TerminalControlsRequest.cs" />
    <Compile Include="../../samples/WebTerminalDemo/DemoWorkload.cs" Link="Samples/DemoWorkload.cs" />
    <Compile Include="../../samples/WebTerminalDemo/DemoTape.cs" Link="Samples/DemoTape.cs" />
    <Compile Include="../../samples/WebTerminalDemo/DemoTapeInfo.cs" Link="Samples/DemoTapeInfo.cs" />
    <Compile Include="../../samples/WebTerminalDemo/DemoTapeCatalog.cs" Link="Samples/DemoTapeCatalog.cs" />
    <Compile Include="../../samples/WebTerminalDemo/TerminalTapePlayback.cs" Link="Samples/TerminalTapePlayback.cs" />
    <Compile Include="../../samples/WebTerminalDemo/TerminalTapeStatus.cs" Link="Samples/TerminalTapeStatus.cs" />
  </ItemGroup>

  <Target Name="CopyNativeLibraryLinux" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Linux')) and Exists('../../src/Hex1b/Terminal/runtimes/linux-x64/native/libhex1binterop.so')">
    <Copy SourceFiles="../../src/Hex1b/Terminal/runtimes/linux-x64/native/libhex1binterop.so" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <Target Name="CopyNativeLibraryOsx" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('OSX')) and Exists('../../src/Hex1b/Terminal/runtimes/osx-arm64/native/libhex1binterop.dylib')">
    <Copy SourceFiles="../../src/Hex1b/Terminal/runtimes/osx-arm64/native/libhex1binterop.dylib" DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

  <PropertyGroup Condition="$([MSBuild]::IsOSPlatform('Windows'))">
    <WindowsPtyShimRid Condition="'$([System.Runtime.InteropServices.RuntimeInformation]::OSArchitecture)' == 'Arm64'">win-arm64</WindowsPtyShimRid>
    <WindowsPtyShimRid Condition="'$(WindowsPtyShimRid)' == ''">win-x64</WindowsPtyShimRid>
  </PropertyGroup>

  <Target Name="CopyWindowsPtyShim" AfterTargets="Build" Condition="$([MSBuild]::IsOSPlatform('Windows')) and Exists('../../src/Hex1b/obj/windows-pty-shim/$(WindowsPtyShimRid)/native/hex1bpty.exe')">
    <ItemGroup>
      <WindowsPtyShimFiles Include="../../src/Hex1b/obj/windows-pty-shim/$(WindowsPtyShimRid)/native/*.*"
                           Exclude="../../src/Hex1b/obj/windows-pty-shim/$(WindowsPtyShimRid)/native/*.pdb" />
    </ItemGroup>
    <Copy SourceFiles="@(WindowsPtyShimFiles)"
          DestinationFolder="$(TargetDir)runtimes\$(WindowsPtyShimRid)\native\"
          SkipUnchangedFiles="true" />
  </Target>

  <Target Name="SyncHex1bAssemblyToOutput"
          AfterTargets="Build"
          Condition="Exists('../../src/Hex1b/obj/$(Configuration)/net8.0/Hex1b.dll')">
    <Copy SourceFiles="../../src/Hex1b/obj/$(Configuration)/net8.0/Hex1b.dll"
          DestinationFolder="$(TargetDir)"
          SkipUnchangedFiles="false" />
  </Target>

  <ItemGroup>
    <Using Include="Hex1b.Automation" />
  </ItemGroup>

  <ItemGroup>
    <EmbeddedResource Include="TestData\ReflowFixtures.json" />
    <EmbeddedResource Include="TestData\Sixel\*.sixel" />
    <EmbeddedResource Include="TestData\Sixel\Conformance\*.json" />
    <EmbeddedResource Include="TestData\Tape\**\*">
      <LogicalName>TapeConformance/%(RecursiveDir)%(Filename)%(Extension)</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

</Project>
