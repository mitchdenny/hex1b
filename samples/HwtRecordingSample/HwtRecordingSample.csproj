<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Hex1b" Version="0.166.0" />
    <Compile Include="Program.cs;GalleryState.cs;GalleryArtwork.cs" />
    <None Include="@(Compile);HwtRecordingSample.csproj;README.md;.gitignore;LICENSE"
          CopyToOutputDirectory="PreserveNewest"
          TargetPath="source/%(Filename)%(Extension)" />
  </ItemGroup>
</Project>
